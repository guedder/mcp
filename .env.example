# Public tools work with no creds. Authenticated tools (check-in list, compras,
# usuario_logado, get_lote) need a Guedder login. Set these in the MCP client's
# "env" block (see README), not committed.
GUEDDER_API_BASE=https://api.guedder.com
GUEDDER_EMAIL=
GUEDDER_PASSWORD=

# Segredo dos códigos de confirmação das escritas e da prova de consent.
# Obrigatório com mais de uma réplica (igual em todas); sem ele, aleatório por processo.
GUEDDER_MCP_CONFIRM_SECRET=
